---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const pageTitle = `${frontmatter.title} | GTriXy`;
---

<BaseLayout title={pageTitle} description={frontmatter.description}>
  <article class="article">
    <p><a href="/">cd ..</a></p>
    <p>
      <span class="prompt">gtrixy@web</span>:<span class="muted">~/posts</span>$
      <span class="command">cat {Astro.url.pathname.split('/').filter(Boolean).at(-1)}.md</span>
    </p>
    <h1>{frontmatter.title}</h1>
    <p class="muted">
      {frontmatter.date}
      {frontmatter.tags?.length ? ` / ${frontmatter.tags.join(', ')}` : ''}
    </p>
    <slot />
  </article>
</BaseLayout>
