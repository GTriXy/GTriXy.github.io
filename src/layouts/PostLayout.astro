---
import BaseLayout from './BaseLayout.astro';

const { frontmatter } = Astro.props;
const pageTitle = frontmatter.title + ' | GTriXy EVA Terminal';
---

<BaseLayout title={pageTitle} description={frontmatter.description}>
  <main class="article-shell">
    <header class="article-top">
      <a href="/">GDI-EVA&gt; return --home</a>
      <span class="dim">ARCHIVE / READ-ONLY</span>
    </header>
    <article class="article">
      <p class="prompt">GDI-EVA&gt; open file</p>
      <h1>{frontmatter.title}</h1>
      <p class="article-meta">
        {frontmatter.date}
        {frontmatter.tags?.length ? ' / ' + frontmatter.tags.join(', ') : ''}
      </p>
      <slot />
    </article>
  </main>
</BaseLayout>
