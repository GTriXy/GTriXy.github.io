---
import BaseLayout from '../layouts/BaseLayout.astro';

type Post = {
  url: string;
  frontmatter: {
    title: string;
    description: string;
    date: string;
    tags?: string[];
  };
};

const postModules = import.meta.glob<Post>('./posts/*.md');
const posts = await Promise.all(Object.values(postModules).map((loadPost) => loadPost()));
const sortedPosts = posts.sort(
  (a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf(),
);
---

<BaseLayout>
  <section class="hud">
    <div>
      <p class="kicker">SECURE ACCESS / PERSONAL ARCHIVE</p>
      <h1>GTriXy<span class="cursor"></span></h1>
      <p class="muted">Field notes, build logs, experiments, and after-action reports.</p>
    </div>
    <div class="status-grid" aria-label="System status">
      <span>LINK <strong>ONLINE</strong></span>
      <span>MODE <strong>READ-ONLY</strong></span>
      <span>AUTH <strong>PUBLIC</strong></span>
      <span>ZONE <strong>WEB</strong></span>
    </div>
  </section>

  <nav class="nav" aria-label="Primary">
    <a href="#briefing">BRIEFING</a>
    <a href="#logs">FIELD-LOGS</a>
    <a href="#assets">ASSETS</a>
    <a href="https://github.com/GTriXy">GITHUB</a>
  </nav>

  <section class="grid">
    <div id="briefing" class="block tactical-map">
      <h2>&gt; OPEN BRIEFING</h2>
      <p>
        这里是 GTriXy 的个人指挥台。记录技术折腾、项目推进、问题复盘，以及一些值得留档的想法。
      </p>
      <dl class="intel-list">
        <div><dt>CALLSIGN</dt><dd>GTriXy</dd></div>
        <div><dt>CHANNEL</dt><dd>github-pages</dd></div>
        <div><dt>OBJECTIVE</dt><dd>write, build, ship</dd></div>
      </dl>
    </div>

    <div id="assets" class="block">
      <h2>&gt; LIST ACTIVE ASSETS</h2>
      <div class="asset-row"><span>personal-blog</span><strong>ACTIVE</strong></div>
      <div class="asset-row"><span>notes-lab</span><strong>STANDBY</strong></div>
      <div class="asset-row"><span>experiments</span><strong>SCOUTING</strong></div>
    </div>
  </section>

  <section id="logs" class="logs-panel">
    <div class="section-head">
      <h2>&gt; QUERY FIELD LOGS</h2>
      <span class="muted">SORT: newest first</span>
    </div>
    <div class="post-list">
      {
        sortedPosts.map((post, index) => (
          <a class="post-link" href={post.url}>
            <span class="log-index">LOG-{String(index + 1).padStart(3, '0')}</span>
            <strong>{post.frontmatter.title}</strong>
            <span class="muted">
              {post.frontmatter.date} / {post.frontmatter.description}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
