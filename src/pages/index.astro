    const getFastfetchHtml = () => {
      const measureChWidth = () => {
        const probe = document.createElement('span');
        probe.textContent = '0'.repeat(50);
        probe.className = 'fastfetch-art';
        probe.style.cssText = 'position:absolute;visibility:hidden;white-space:pre;';
        output.append(probe);
        const width = probe.getBoundingClientRect().width / 50;
        probe.remove();
        return width || 8;
      };
      const selectFastfetchArt = () => {
        const chWidth = measureChWidth();
        const outputWidth = output.clientWidth || window.innerWidth;
        const isCompact = window.matchMedia('(max-width: 680px)').matches;
        const infoReserve = isCompact ? 0 : Math.min(470, Math.max(340, outputWidth * 0.43));
        const gapReserve = isCompact ? 0 : Math.min(42, Math.max(18, outputWidth * 0.04));
        const artPixels = Math.max(0, outputWidth - infoReserve - gapReserve);
        const targetCols = Math.floor((isCompact ? outputWidth : artPixels) / chWidth);
        return fastfetchArts.reduce((best, art) => {
          if (art.cols <= targetCols + 6) return art;
          return best;
        }, fastfetchArts[0]);
      };
      const selectedArt = selectFastfetchArt();
      const fastfetchArt = selectedArt.art;
      const countDays = (startDate: Date, endDate: Date) => Math.floor((endDate.getTime() - startDate.getTime()) / 86400000);
      const getAge = () => {
        const origin = new Date(1995, 3, 26);
        const now = new Date();
        let years = now.getFullYear() - origin.getFullYear();
        const anniversary = new Date(now.getFullYear(), origin.getMonth(), origin.getDate());
        if (now < anniversary) years -= 1;
        const lastAnniversary = new Date(origin.getFullYear() + years, origin.getMonth(), origin.getDate());
        const days = countDays(lastAnniversary, now);
        return years + ' years ' + days + ' days';
      };
      const getBrowserName = () => {
        const ua = navigator.userAgent;
        if (/Edg\//.test(ua)) return 'Microsoft Edge';
        if (/Firefox\//.test(ua)) return 'Firefox';
        if (/OPR\//.test(ua) || /Opera\//.test(ua)) return 'Opera';
        if (/Chrome\//.test(ua) || /Chromium\//.test(ua)) return 'Chromium';
        if (/Safari\//.test(ua)) return 'Safari';
        return 'Browser';
      };
      const getDeviceLabel = () => {
        const ua = navigator.userAgent;
        const mobile = /Mobi|Android|iPhone|iPad|iPod/i.test(ua);
        const platformHint = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform;
        const platform = platformHint || (/Android/i.test(ua) ? 'Android' : /iPhone|iPad|iPod/i.test(ua) ? 'iOS' : /Windows/i.test(ua) ? 'Windows' : /Mac OS X/i.test(ua) ? 'macOS' : /Linux/i.test(ua) ? 'Linux' : 'Unknown platform');
        const cores = navigator.hardwareConcurrency ? navigator.hardwareConcurrency + ' threads' : 'threads unknown';
        return (mobile ? 'Mobile' : 'Desktop') + ' / ' + platform + ' / ' + cores;
      };
      const memory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory;
      const connection = (navigator as Navigator & { connection?: { effectiveType?: string } }).connection?.effectiveType;
      const pcLines = [
        ['DEV', getDeviceLabel()],
        ['CPU', navigator.hardwareConcurrency ? navigator.hardwareConcurrency + ' logical cores visible' : 'unavailable'],
        ['MEM', memory ? memory + ' GiB visible' : 'unavailable'],
        ['MON', screen.width + 'x' + screen.height + '@' + window.devicePixelRatio + 'x'],
        ['WIN', window.innerWidth + 'x' + window.innerHeight + ' viewport'],
        ['NET', connection ? connection : 'unavailable'],
      ];
      const topLines = [
        ['OS', 'EVA TERMINAL'],
        ['KER', 'EVA System 4.26.95 Hotfix 2030'],
        ['AGE', getAge()],
        ['USR', 'GTriXy@GDI CSFT Dead-6'],
      ];
      const wmLines = [
        ['WEB', getBrowserName()],
        ['SHE', 'GDI-EVA Terminal'],
        ['TER', 'Astro Client Runtime'],
      ];
      const renderRow = ([key, value]: string[]) => '<span class="fastfetch-key">' + key + '</span><span class="fastfetch-value">' + escapeHtml(value) + '</span>';
      const lineCount = fastfetchArt.split('\n').length;
      return '<span class="fastfetch" data-lines="' + lineCount + '"><span class="fastfetch-art">' + escapeHtml(fastfetchArt) + '</span><span class="fastfetch-info"><span class="fastfetch-section">' + topLines.map(renderRow).join('') + '</span><span class="fastfetch-section">' + wmLines.map(renderRow).join('') + '</span><span class="fastfetch-section">' + pcLines.map(renderRow).join('') + '</span></span></span>';
    };

    const fitFastfetchOutput = (row: HTMLElement) => {
      requestAnimationFrame(() => {
        const block = row.querySelector<HTMLElement>('.fastfetch');
        const art = row.querySelector<HTMLElement>('.fastfetch-art');
        const info = row.querySelector<HTMLElement>('.fastfetch-info');
        if (!block || !art || !info || window.matchMedia('(max-width: 680px)').matches) return;
        const lines = Number(block.dataset.lines) || art.textContent.split('\n').length || 1;
        const infoHeight = info.getBoundingClientRect().height;
        const fontSize = Math.max(4.5, Math.min(13, infoHeight / (lines * 1.05)));
        art.style.fontSize = fontSize + 'px';
      });
    };

    const usageLines = {
      language: 'language&gt; language &lt;id&gt; . switch help language: en, zh, ru',
      open: 'open&gt; open &lt;id&gt; ..... open entry, e.g. open hello-world',
    };
    const commandNames = [
      'about',
      'bilibili',
      'clear',
      'github',
      'fastfetch',
      'help',
      'language',
      'open',
      'posts',
      'projects',
    ].sort((a, b) => a.localeCompare(b));
    const commandArgs = {
      language: ['en', 'ru', 'zh'],
      open: posts.map((post) => post.slug).filter(Boolean).sort((a, b) => a.localeCompare(b)),
    };
    const commandHistory = [];
    let historyIndex = 0;
    let currentSuggestion = '';


    const updateTerminalTime = () => {
      if (!terminalTime) return;
      terminalTime.textContent = new Intl.DateTimeFormat('en-CA', {
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      }).format(new Date()).replace(',', '');
    };

    const getSuggestion = () => {
      const rawValue = input.value;
      const value = rawValue.toLowerCase();
      if (!value) return '';
      const endsWithSpace = /\s$/.test(rawValue);
      const parts = value.trimStart().split(/\s+/);
      const commandPart = parts[0] || '';

      if (parts.length === 1 && !endsWithSpace) {
        const commandMatch = commandNames.find((candidate) => candidate.startsWith(commandPart));
        if (!commandMatch || commandMatch === commandPart) return '';
        return commandMatch.slice(commandPart.length);
      }

      if (!(commandPart in commandArgs)) return '';
      const typedArg = endsWithSpace ? '' : (parts.at(-1) || '');
      const argMatch = commandArgs[commandPart].find((candidate: string) => candidate.startsWith(typedArg));
      if (!argMatch || argMatch === typedArg) return '';
      return argMatch.slice(typedArg.length);
    };

    const updateCommandCursor = () => {
      const length = Math.max(0, input.value.length);
      input.style.setProperty('--command-width', length + 'ch');
      currentSuggestion = getSuggestion();
      commandGhost.textContent = currentSuggestion;
    };

    const acceptSuggestion = () => {
      if (!currentSuggestion) return false;
      input.value += currentSuggestion;
      updateCommandCursor();
      return true;
    };

    const fitVersionLine = () => {
      if (!versionLine || !hotfixLabel || !hotfixBuild) return;
      const applyWordSpacing = () => {
        versionLine.style.wordSpacing = '0px';
        const targetWidth = versionLine.clientWidth;
        const naturalWidth = versionLine.scrollWidth;
        const words = versionLine.textContent.trim().split(/\s+/).length;
        const gaps = Math.max(1, words - 1);
        const spacing = (targetWidth - naturalWidth) / gaps;
        if (naturalWidth <= targetWidth && spacing >= 0 && spacing <= 18) {
          versionLine.style.wordSpacing = spacing + 'px';
          return true;
        }
        return naturalWidth <= targetWidth;
      };

      hotfixLabel.hidden = false;
      hotfixBuild.hidden = false;
      versionLine.style.fontSize = '';
      if (applyWordSpacing()) return;

      hotfixBuild.hidden = true;
      if (applyWordSpacing()) return;

      hotfixLabel.hidden = true;
      applyWordSpacing();
    };

    const escapeHtml = (value: string) =>
      value.replace(/[&<>'"]/g, (char: string) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        "'": '&#39;',
        '"': '&quot;',
      } as Record<string, string>)[char]);

    const print = (lines = []) => {
      const rows = [];
      for (const line of lines) {
        const row = document.createElement('p');
        row.innerHTML = line;
        output.append(row);
        rows.push(row);
      }
      output.scrollTop = output.scrollHeight;
      return rows;
    };

    const delay = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    const authorizeCommand = async () => {
      print(['<span class="dim">AUTHORIZATION</span> / Awaiting command authorization...']);
      await delay(1500);
      print(['<span class="prompt">AUTHORIZATION</span> / Access granted.']);
    };

    const showHelp = () => print(helpLines[currentLanguage]);

    const bindDynamicButtons = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
        button.addEventListener('click', () => openPost(button.dataset.open));
      });
    };

    const showPosts = () => {
      if (!posts.length) {
        print(['<span class="warn">NO LOGS FOUND</span>']);
        return;
      }
      print(posts.map((post, index) => {
        const id = String(index + 1).padStart(3, '0');
        return '<span class="dim">LOG-' + id + '</span> ' + post.date + ' / <button class="inline-command" type="button" data-open="' + post.slug + '">' + escapeHtml(post.title) + '</button> / ' + escapeHtml(post.description);
      }));
      bindDynamicButtons();
    };

    const openPost = (slug: string) => {
      const normalized = slug.trim().toLowerCase();
      const post = posts.find((item) => item.slug === normalized || item.title.toLowerCase() === normalized);
      if (!post) {
        print(['<span class="warn">ACCESS DENIED</span> / 未找到档案: ' + escapeHtml(slug)]);
        return;
      }
      window.location.href = post.url;
    };

    const runCommand = async (rawCommand: string) => {
      const command = rawCommand.trim().toLowerCase();
      if (!command) return;
      print(['<span class="prompt">GDI-EVA&gt;</span> ' + escapeHtml(rawCommand)]);

      const requestedLanguage = command.startsWith('language ') ? command.slice(9).trim() : '';
      const isKnownLanguage = command.startsWith('language ') && requestedLanguage in helpLines;
      const needsArgument = command === 'language' || command === 'open';
      const isValidCommand =
        command === 'help' ||
        command === 'posts' ||
        command === 'logs' ||
        command === 'about' ||
        command === 'projects' ||
        command === 'github' ||
        command === 'bilibili' ||
        command === 'fastfetch' ||
        command === 'clear' ||
        command.startsWith('open ') ||
        isKnownLanguage;

      if (needsArgument) {
        print([usageLines[command]]);
        return;
      }

      if (!isValidCommand) {
        if (command.startsWith('language ')) {
          print(['<span class="error-token">GDI-EVA</span>&gt; <span class="error-token">Error</span> : Unknown Language &gt; ' + escapeHtml(requestedLanguage)]);
        } else {
          print(['<span class="error-token">GDI-EVA</span>&gt; <span class="error-token">Error</span> : Unknown Command &gt; ' + escapeHtml(command)]);
        }
        return;
      }

      await authorizeCommand();

      if (command === 'help') showHelp();
      else if (command === 'posts' || command === 'logs') showPosts();
      else if (command === 'about') print(aboutLines[currentLanguage]);
      else if (command === 'projects') print(projectLines[currentLanguage]);
      else if (command === 'fastfetch') {
        const rows = print([getFastfetchHtml()]);
        fitFastfetchOutput(rows[0]);
      }
      else if (isKnownLanguage) {
        currentLanguage = requestedLanguage;
        print(['<span class="prompt">LANGUAGE</span> / Language set to ' + requestedLanguage + '.']);
      }
      else if (command === 'github') window.location.href = 'https://github.com/GTriXy';
      else if (command === 'bilibili') window.location.href = 'https://space.bilibili.com/388115572';
      else if (command === 'clear') {
        output.querySelectorAll('p:not(.persistent-line)').forEach((line) => line.remove());
      }
      else if (command.startsWith('open ')) openPost(command.slice(5));
    };

    commandButtons.forEach((button) => {
      button.addEventListener('click', () => {
        input.value = button.dataset.command || '';
        updateCommandCursor();
        input.focus();
      });
    });

    input.addEventListener('input', () => {
      historyIndex = commandHistory.length;
      updateCommandCursor();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' && acceptSuggestion()) {
        event.preventDefault();
        return;
      }
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (!commandHistory.length) return;
        historyIndex = Math.max(0, historyIndex - 1);
        input.value = commandHistory[historyIndex] || '';
        updateCommandCursor();
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!commandHistory.length) return;
        historyIndex = Math.min(commandHistory.length, historyIndex + 1);
        input.value = commandHistory[historyIndex] || '';
        updateCommandCursor();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const command = input.value;
      if (command.trim()) {
        commandHistory.push(command);
        historyIndex = commandHistory.length;
      }
      input.value = '';
      updateCommandCursor();
      input.disabled = true;
      await runCommand(command);
      input.disabled = false;
      input.focus();
    });

    updateCommandCursor();
    updateTerminalTime();
    setInterval(updateTerminalTime, 1000);
    fitVersionLine();
    window.addEventListener('resize', fitVersionLine);
    window.addEventListener('click', () => input.focus());
    input.focus();
  </script>
</BaseLayout>
